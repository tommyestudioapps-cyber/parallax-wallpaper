{
  "expo": {
    "name": "Parallax Wallpaper Maker",
    "slug": "parallax-wallpaper",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "parallax-wallpaper",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/parallax-layered-opening-titled.png",
      "resizeMode": "contain",
      "backgroundColor": "#090B10"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.parallaxwallpaper.app"
    },
    "android": {
      "package": "com.parallaxwallpaper.app",
      "permissions": [
        "android.permission.HIGH_SAMPLING_RATE_SENSORS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-dev-client",
      "expo-web-browser",
      "./plugins/withMlKitSubjectSegmentDependency",
      "./plugins/withGradleBuildMemory",
      "./plugins/withParallaxLiveWallpaper"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "5e0f6b4b-e860-4610-9fb7-e43043987b14"
      }
    },
    "owner": "tommyestudioapps"
  }
}
